# Admin portal image. Same source + build as the tenant portal (Dockerfile),
# but nginx serves admin.html at the root instead of index.html. Separate image
# + separate Deployment gives the admin app its own runtime, config, and network
# identity (ADR-027).
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
