---
// The landing page in one language (docs/features/public-site/design.md#site-language). pages/index.astro renders
// it in English, pages/vi/index.astro in Vietnamese; every word comes from src/i18n/landing.js.
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource/be-vietnam-pro/800.css';
import '../styles/tokens.css';
import { copy } from '../i18n/landing.js';

interface Props {
  lang: 'en' | 'vi';
}

const t = copy[Astro.props.lang];
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={t.home}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2.5" width="12" height="4.5" rx="1.2" stroke="currentColor" stroke-width="1.6"/><rect x="2" y="9" width="12" height="4.5" rx="1.2" stroke="currentColor" stroke-width="1.6"/><circle cx="4.8" cy="4.75" r="0.9" fill="currentColor"/><circle cx="4.8" cy="11.25" r="0.9" fill="currentColor"/></svg>
          </span>
          OpenViCloud
        </a>
        <nav aria-label={t.navLabel}>
          <a href="#pricing">{t.nav.pricing}</a>
          <a href="#features">{t.nav.features}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a href={t.docs}>{t.nav.docs}</a>
          <a class="lang-switch" href={t.switchTo.href} hreflang={t.switchTo.lang} lang={t.switchTo.lang} data-lang-switch={t.switchTo.lang}>{t.switchTo.label}</a>
          <a class="button button-primary button-small" href={t.docs} data-signup>{t.nav.signup}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <p class="eyebrow">{t.eyebrow}</p>
            <h1>{t.heading}</h1>
            <p class="lead">{t.lead}</p>
            <ul class="checks">
              {t.heroChecks.map((text) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {text}
                </li>
              ))}
            </ul>
            <div class="actions">
              <a class="button button-primary" href="#pricing">{t.choosePlan}</a>
              <a class="button button-ghost" href={t.docs}>{t.readDocs}</a>
            </div>
            <p class="from" data-starting hidden>{t.startingBefore} <b data-starting-price></b> {t.startingAfter}</p>
            <p class="from">{t.noticeBefore} <a href={t.limitsPage}>{t.noticeLink}</a> {t.noticeAfter}</p>
          </div>

          <figure class="panel" aria-label={t.panel.label}>
            <div class="panel-top" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span></div>
            <div class="vm">
              <span class="vm-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="3.5" width="14" height="5.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="11" width="14" height="5.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/></svg></span>
              <span class="vm-name">web-01</span>
              <span class="pill pill-running"><i></i>Running</span>
              <span class="vm-meta">2 vCPU · 4 GB · {t.panel.billed}</span>
            </div>
            <div class="vm">
              <span class="vm-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="3.5" width="14" height="5.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="11" width="14" height="5.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/></svg></span>
              <span class="vm-name">worker-02</span>
              <span class="pill pill-stopped"><i></i>Stopped</span>
              <span class="vm-meta">1 vCPU · 2 GB · {t.panel.notBilled}</span>
            </div>
            <div class="meter">
              <div><small>Network</small><b>net-app · 10.0.0.0/24</b></div>
              <div><small>Volume</small><b>data-01 · {t.panel.attachedTo}</b></div>
            </div>
            <figcaption>{t.panel.caption}</figcaption>
          </figure>
        </div>
      </section>

      <nav class="subnav" aria-label={t.subnavLabel}>
        <div class="wrap subnav-row">
          <a href="#pricing">{t.subnav.pricing}</a>
          <a href="#features">{t.subnav.features}</a>
          <a href="#cli">{t.subnav.cli}</a>
          <a href="#get-started">{t.subnav.start}</a>
          <a href="#limitations">{t.subnav.limits}</a>
          <a href="#faq">{t.subnav.faq}</a>
        </div>
      </nav>

      <section class="block" aria-labelledby="pricing">
        <div class="wrap">
          <div class="section-head center">
            <h2 id="pricing">{t.pricing.heading}</h2>
            <p>{t.pricing.sub}</p>
          </div>
          <div data-pricing aria-live="polite">
            <p class="muted center" data-pricing-loading>{t.pricing.loading}</p>
          </div>
          <p class="fineprint">{t.pricing.fineprint}</p>
          <div class="included">
            <h3>{t.pricing.includedTitle}</h3>
            <ul>
              {t.included.map((text) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {text}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="block alt" aria-labelledby="features">
        <div class="wrap">
          <div class="section-head">
            <h2 id="features">{t.featuresHeading}</h2>
            <p>{t.featuresSub}</p>
          </div>
          <div class="features">
            {t.features.map((f) => (
              <article class="feature">
                <span class="feature-icon" aria-hidden="true">
                  {f.icon === 'vm' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="4" width="16" height="6" rx="1.6" stroke="currentColor" stroke-width="1.7"/><rect x="3" y="12" width="16" height="6" rx="1.6" stroke="currentColor" stroke-width="1.7"/><circle cx="6.5" cy="7" r="1" fill="currentColor"/><circle cx="6.5" cy="15" r="1" fill="currentColor"/></svg>}
                  {f.icon === 'network' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="5" cy="11" r="2.4" stroke="currentColor" stroke-width="1.7"/><circle cx="17" cy="5" r="2.4" stroke="currentColor" stroke-width="1.7"/><circle cx="17" cy="17" r="2.4" stroke="currentColor" stroke-width="1.7"/><path d="M7.2 10l7.6-3.8M7.2 12l7.6 3.8" stroke="currentColor" stroke-width="1.7"/></svg>}
                  {f.icon === 'volume' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><ellipse cx="11" cy="5.5" rx="7" ry="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M4 5.5v11c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-11M4 11c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" stroke="currentColor" stroke-width="1.7"/></svg>}
                  {f.icon === 'snapshot' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/><circle cx="11" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M8 6l1.2-2h3.6L14 6" stroke="currentColor" stroke-width="1.7"/></svg>}
                  {f.icon === 'invoice' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="4" y="3" width="14" height="16" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 8h6M8 11.5h6M8 15h3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
                  {f.icon === 'quota' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 3l7 3v5c0 4.2-3 7.2-7 8-4-0.8-7-3.8-7-8V6l7-3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8 11l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="block" aria-labelledby="cli">
        <div class="wrap cli-grid">
          <div>
            <div class="section-head">
              <h2 id="cli">{t.cli.heading}</h2>
              <p>{t.cli.sub}</p>
            </div>
            <h3 class="install-title">{t.cli.installTitle}</h3>
            <div class="install">
              <code data-install-command data-template={t.cli.installCommand}>{t.cli.installCommand.replace('{site}', t.cli.siteFallback)}</code>
              <button type="button" class="button button-ghost button-small" data-copy data-copied={t.cli.copied} aria-label={t.cli.copyLabel} hidden>{t.cli.copy}</button>
            </div>
            <span class="visually-hidden" aria-live="polite" data-copy-status></span>
            <p class="install-note">{t.cli.installNote}</p>
            <a class="button button-ghost button-small" href={t.cli.guide}>{t.cli.guideLink} →</a>
          </div>

          <figure class="panel terminal" aria-label={t.cli.panelLabel}>
            <div class="panel-top" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span></div>
            <pre><code>{t.cli.commands.map((command) => <span class="line">{command}</span>)}</code></pre>
            <figcaption>{t.cli.caption}</figcaption>
          </figure>
        </div>
      </section>

      <section class="block" aria-labelledby="get-started">
        <div class="wrap">
          <div class="section-head">
            <h2 id="get-started">{t.startHeading}</h2>
            <p>{t.startSub}</p>
          </div>
          <ol class="steps">
            {t.steps.map((s) => (
              <li data-step={t.stepLabel}>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <a href={s.href}>{s.link} →</a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="block block-tight" aria-labelledby="limitations">
        <div class="wrap">
          <div class="limits">
            <div>
              <h2 id="limitations">{t.limitsHeading}</h2>
              <p>{t.limitsBody}</p>
              <a class="button button-ghost button-small" href={t.limitsPage}>{t.limitsLink}</a>
            </div>
            <ul>
              {t.limits.map((l) => (
                <li><b>{l.title}</b><span>{l.body}{l.href !== undefined && <> <a href={l.href}>{l.link}</a></>}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="block alt" aria-labelledby="faq">
        <div class="wrap">
          <div class="section-head center">
            <h2 id="faq">{t.faqHeading}</h2>
          </div>
          <div class="faq">
            {t.faq.map((item, index) => (
              <details open={index === 0}>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="wrap">
          <h2>{t.ctaHeading}</h2>
          <p>{t.ctaBody}</p>
          <div class="actions actions-center">
            <a class="button button-primary" href={t.docs} data-signup>{t.nav.signup}</a>
            <a class="button button-ghost" href={t.docs}>{t.readDocs}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <span>© OpenViCloud</span>
        <nav aria-label={t.footerLabel}>
          <a href={t.docs}>{t.footer.docs}</a>
          <a href="#pricing">{t.footer.pricing}</a>
          <a href={t.limitsPage}>{t.footer.limits}</a>
          <a href="#faq">{t.footer.faq}</a>
        </nav>
      </div>
    </footer>

    <script>
      import { vmRows, volumeRows, startingPrice } from '../scripts/pricing.js';
      import { boot } from '../scripts/language.js';
      import { copy } from '../i18n/landing.js';

      const lang = document.documentElement.lang === 'vi' ? 'vi' : 'en';
      const words = copy[lang].script;

      async function getJson(url) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 8000);
        try {
          const response = await fetch(url, { signal: controller.signal, headers: { Accept: 'application/json' } });
          if (response.status !== 200) return null;
          return await response.json();
        } catch {
          return null;
        } finally {
          clearTimeout(timer);
        }
      }

      function element(tag, className, text) {
        const node = document.createElement(tag);
        if (className !== '') node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function checkItem(text) {
        const item = element('li', '');
        item.append(element('span', 'tick', '✓'), document.createTextNode(text));
        return item;
      }

      function planCard(row) {
        const card = element('article', row.featured ? 'plan plan-featured' : 'plan');
        if (row.featured) card.append(element('span', 'badge', words.badge));

        const head = element('div', '');
        head.append(element('h3', '', row.name), element('span', 'tier', `tier ${row.id}`));

        const price = element('div', 'price');
        price.append(element('span', 'price-hour', row.price));
        if (row.monthly !== null) price.append(element('span', 'price-month', row.monthly));

        const specs = element('ul', 'specs');
        specs.append(checkItem(`${row.vcpu} vCPU`), checkItem(`${row.memory} RAM`));

        const button = element('a', row.featured ? 'button button-primary' : 'button button-ghost', `${words.choose} ${row.name}`);
        button.href = copy[lang].docs;
        button.dataset.signup = '';

        card.append(head, price, specs, button);
        return card;
      }

      function renderFallback(container) {
        container.replaceChildren(element('p', 'muted center', words.fallback));
      }

      function renderPlans(container, vms, volumes) {
        const plans = element('div', 'plans');
        for (const row of vms) plans.append(planCard(row));

        const storage = element('div', 'volume-line');
        for (const row of volumes) {
          storage.append(element('span', '', `${words.volume} ${row.name}: ${row.price}`));
          if (row.monthly !== null) storage.append(element('span', 'muted', row.monthly));
        }
        container.replaceChildren(plans, storage);
      }

      // Runs after the cards exist: the card buttons are created by renderPlans.
      function pointSignupAt(portalUrl) {
        for (const link of document.querySelectorAll('[data-signup]')) link.setAttribute('href', portalUrl);
      }

      async function main() {
        const container = document.querySelector('[data-pricing]');
        const config = await getJson('/config.json');
        let portalUrl = null;
        if (config !== null && typeof config.portalUrl === 'string' && config.portalUrl.startsWith('http')) {
          portalUrl = config.portalUrl;
        }

        const apiBaseUrl = config === null ? null : config.apiBaseUrl;
        if (typeof apiBaseUrl === 'string' && apiBaseUrl.startsWith('http')) {
          const [vmData, volumeData] = await Promise.all([
            getJson(`${apiBaseUrl}/v1/vm-offerings`),
            getJson(`${apiBaseUrl}/v1/volume-offerings`),
          ]);
          const vms = vmRows(vmData, lang);
          const volumes = volumeRows(volumeData, lang);
          if (vms !== null && volumes !== null) {
            renderPlans(container, vms, volumes);
            document.querySelector('[data-starting-price]').textContent = startingPrice(vmData, lang);
            document.querySelector('[data-starting]').hidden = false;
          } else {
            renderFallback(container);
          }
        } else {
          renderFallback(container);
        }

        if (portalUrl !== null) pointSignupAt(portalUrl);
      }

      // The install line names the site the page came from: the same site serves install.sh with its own address
      // (docs/features/cli/design.md#install-script). The copy button needs the clipboard, so it stays hidden without it.
      function showInstallCommand() {
        const command = document.querySelector('[data-install-command]');
        const line = command.dataset.template.replace('{site}', window.location.origin);
        command.textContent = line;

        if (navigator.clipboard === undefined) return;
        const button = document.querySelector('[data-copy]');
        const status = document.querySelector('[data-copy-status]');
        button.hidden = false;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(line);
          } catch {
            // Clipboard refused (permission, embedded browser): select the line so it can be copied by hand.
            const range = document.createRange();
            range.selectNodeContents(command);
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            return;
          }
          button.textContent = button.dataset.copied;
          status.textContent = button.dataset.copied;
        });
      }

      boot();
      showInstallCommand();
      main();
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      html { background: var(--color-background); scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--color-background);
        color: var(--color-foreground);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 6px; }
      h1, h2, h3 { margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
      p { margin: 0; }
      [hidden] { display: none !important; }
      .wrap { width: 100%; max-width: 72.5rem; margin: 0 auto; padding: 0 1.25rem; }
      .skip { position: absolute; left: -999px; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .skip:focus { left: 1rem; top: 1rem; background: var(--color-accent); color: var(--color-accent-foreground); padding: 0.5rem 1rem; z-index: 20; }
      .muted { color: var(--color-muted-foreground); }
      .center { text-align: center; margin-left: auto; margin-right: auto; }

      .site-header { position: sticky; top: 0; z-index: 10; background: hsl(225 18% 5% / 0.88); backdrop-filter: blur(12px); border-bottom: 1px solid var(--color-border); }
      .header-row { display: flex; align-items: center; gap: 1.5rem; min-height: 4rem; }
      .brand { display: flex; align-items: center; gap: 0.625rem; text-decoration: none; font-weight: 800; font-size: 1.125rem; letter-spacing: -0.02em; }
      .brand-mark { width: 1.75rem; height: 1.75rem; border-radius: 0.5rem; background: var(--color-accent); color: var(--color-accent-foreground); display: grid; place-items: center; }
      .site-header nav { display: flex; align-items: center; gap: 1.375rem; margin-left: auto; font-size: 0.9375rem; }
      .site-header nav a { white-space: nowrap; }
      .site-header nav a:not(.button) { text-decoration: none; color: var(--color-muted-foreground); }
      .site-header nav a:not(.button):hover { color: var(--color-foreground); }

      .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 1.25rem; border-radius: 0.625rem; font-weight: 600; font-size: 0.9375rem; text-decoration: none; border: 1px solid transparent; transition: transform 0.15s ease, background 0.15s ease; }
      .button-primary { background: var(--color-accent); color: var(--color-accent-foreground); }
      .button-primary:hover { transform: translateY(-1px); }
      .button-ghost { border-color: var(--color-border); color: var(--color-foreground); }
      .button-ghost:hover { background: var(--color-surface); }
      .button-small { padding: 0 1rem; font-size: 0.875rem; }

      .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--color-border); }
      .hero::before { content: ""; position: absolute; top: -40%; right: -10%; left: 35%; height: 32rem; background: radial-gradient(closest-side, var(--color-accent-soft), transparent 70%); pointer-events: none; }
      .hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 3rem; align-items: center; padding-top: 4.5rem; padding-bottom: 5rem; }
      .eyebrow { font-size: 0.875rem; font-weight: 600; color: var(--color-accent); letter-spacing: 0.02em; }
      .hero h1 { font-size: clamp(2.125rem, 5.2vw, 3.5rem); line-height: 1.08; font-weight: 800; margin: 0.875rem 0 1.125rem; }
      .lead { color: var(--color-muted-foreground); font-size: 1.125rem; max-width: 34em; }
      .checks { list-style: none; padding: 0; margin: 1.5rem 0 1.75rem; display: grid; gap: 0.625rem; }
      .checks li { display: flex; gap: 0.625rem; align-items: flex-start; }
      .checks svg, .included svg { flex: none; margin-top: 0.25rem; color: var(--color-accent); }
      .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .actions-center { justify-content: center; }
      .from { margin-top: 1.125rem; font-size: 0.875rem; color: var(--color-muted-foreground); }
      .from + .from { margin-top: 0.375rem; }
      .from b { color: var(--color-foreground); font-variant-numeric: tabular-nums; }

      .panel { margin: 0; min-width: 0; background: linear-gradient(180deg, var(--color-surface), var(--color-raised)); border: 1px solid var(--color-border); border-radius: 1.125rem; padding: 1.125rem; box-shadow: 0 30px 80px -30px hsl(0 0% 0% / 0.8); }
      .panel-top { margin-bottom: 0.875rem; }
      .dots { display: flex; gap: 0.375rem; }
      .dots i { width: 0.625rem; height: 0.625rem; border-radius: 50%; background: var(--color-border); display: block; }
      .vm { display: grid; grid-template-columns: auto 1fr auto; gap: 0.25rem 0.875rem; align-items: center; padding: 0.875rem; border: 1px solid var(--color-border); border-radius: 0.75rem; background: var(--color-background); }
      .vm + .vm { margin-top: 0.625rem; }
      .vm-icon { grid-row: span 2; width: 2.5rem; height: 2.5rem; border-radius: 0.625rem; background: var(--color-accent-soft); color: var(--color-accent); display: grid; place-items: center; }
      .vm-name { font-family: var(--font-mono); font-size: 0.9375rem; }
      .vm-meta { grid-column: 2; font-size: 0.8125rem; color: var(--color-muted-foreground); }
      .pill { grid-row: span 2; display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.625rem; border-radius: 999px; border: 1px solid var(--color-border); }
      .pill i { width: 0.4375rem; height: 0.4375rem; border-radius: 50%; display: block; }
      .pill-running { color: var(--color-running); }
      .pill-running i { background: var(--color-running); }
      .pill-stopped { color: var(--color-stopped); }
      .pill-stopped i { background: var(--color-stopped); }
      .meter { margin-top: 0.875rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.625rem; }
      .meter div { min-width: 0; border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 0.75rem 0.875rem; background: var(--color-background); }
      .meter small { display: block; font-size: 0.75rem; color: var(--color-muted-foreground); }
      .meter b { font-family: var(--font-mono); font-weight: 400; font-size: 0.875rem; }
      .panel figcaption { margin-top: 0.75rem; font-size: 0.75rem; color: var(--color-muted-foreground); text-align: right; }

      .subnav { border-bottom: 1px solid var(--color-border); }
      .subnav-row { display: flex; gap: 0.375rem; overflow-x: auto; padding-top: 0.625rem; padding-bottom: 0.625rem; }
      .subnav a { flex: none; display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 0.875rem; border-radius: 999px; text-decoration: none; font-size: 0.875rem; color: var(--color-muted-foreground); }
      .subnav a:hover { background: var(--color-surface); color: var(--color-foreground); }

      .block { padding-top: 5rem; padding-bottom: 5rem; scroll-margin-top: 4rem; }
      .block-tight { padding-top: 0; }
      .block h2, .cta h2 { scroll-margin-top: 5rem; }
      .alt { background: var(--color-raised); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
      .section-head { max-width: 40rem; margin-bottom: 2.25rem; }
      .section-head h2 { font-size: clamp(1.75rem, 3.6vw, 2.5rem); line-height: 1.15; font-weight: 800; }
      .section-head p { color: var(--color-muted-foreground); margin-top: 0.75rem; font-size: 1.0625rem; }

      .plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
      .plan { position: relative; display: flex; flex-direction: column; gap: 1.125rem; min-width: 0; padding: 1.625rem 1.375rem 1.375rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-raised); }
      .plan-featured { border-color: var(--color-accent); background: linear-gradient(180deg, var(--color-accent-soft), var(--color-raised) 45%); }
      .badge { position: absolute; top: -0.75rem; left: 1.375rem; background: var(--color-accent); color: var(--color-accent-foreground); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.25rem 0.625rem; border-radius: 999px; }
      .plan h3 { font-size: 1.25rem; font-weight: 700; }
      .tier { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted-foreground); }
      .price { display: flex; flex-direction: column; gap: 0.25rem; font-variant-numeric: tabular-nums; }
      .price-hour { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; overflow-wrap: anywhere; }
      .price-month { font-size: 0.875rem; color: var(--color-muted-foreground); }
      .specs { list-style: none; padding: 1rem 0 0; margin: 0; display: grid; gap: 0.5rem; border-top: 1px solid var(--color-border); font-size: 0.9375rem; }
      .specs li { display: flex; gap: 0.625rem; align-items: center; }
      .tick { color: var(--color-accent); font-weight: 700; }
      .plan .button { margin-top: auto; width: 100%; }
      .volume-line { margin-top: 1.125rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border: 1px dashed var(--color-border); border-radius: var(--radius); font-variant-numeric: tabular-nums; }
      .fineprint { margin-top: 0.875rem; color: var(--color-muted-foreground); font-size: 0.8125rem; max-width: 70em; }
      .included { margin-top: 2.5rem; padding: 1.5rem; border-radius: var(--radius); background: var(--color-surface); }
      .included h3 { font-size: 1.0625rem; margin-bottom: 1rem; }
      .included ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.75rem 1.5rem; font-size: 0.9375rem; }
      .included li { display: flex; gap: 0.625rem; align-items: flex-start; }

      .features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
      .feature { display: flex; flex-direction: column; gap: 0.625rem; min-width: 0; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-background); }
      .feature-icon { width: 2.75rem; height: 2.75rem; border-radius: 0.75rem; background: var(--color-accent-soft); color: var(--color-accent); display: grid; place-items: center; margin-bottom: 0.375rem; }
      .feature h3 { font-size: 1.125rem; font-weight: 700; }
      .feature p { color: var(--color-muted-foreground); font-size: 0.9375rem; }

      .cli-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
      .cli-grid > * { min-width: 0; }
      .cli-grid .section-head { margin-bottom: 1.75rem; }
      .install-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.625rem; }
      .install { display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.375rem 0.375rem 1rem; border: 1px solid var(--color-border); border-radius: 0.75rem; background: var(--color-raised); }
      .install code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; padding: 0.625rem 0; font-family: var(--font-mono); font-size: 0.875rem; }
      .install .button { flex: none; background: var(--color-surface); font: inherit; font-size: 0.875rem; font-weight: 600; cursor: pointer; }
      .install-note { margin: 0.75rem 0 1.25rem; font-size: 0.875rem; color: var(--color-muted-foreground); }
      .terminal pre { margin: 0; overflow-x: auto; padding: 1rem; border: 1px solid var(--color-border); border-radius: 0.75rem; background: var(--color-background); font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.75; }
      .terminal .line { display: block; white-space: pre; }
      .terminal .line::before { content: "$ "; color: var(--color-accent); }

      .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; counter-reset: step; }
      .steps li { counter-increment: step; padding: 1.5rem; border-top: 2px solid var(--color-accent); background: var(--color-raised); border-radius: 0 0 var(--radius) var(--radius); }
      .steps li::before { content: attr(data-step) " " counter(step); display: block; margin-bottom: 0.5rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-accent); }
      .steps h3 { font-size: 1.125rem; margin-bottom: 0.375rem; }
      .steps p { color: var(--color-muted-foreground); font-size: 0.9375rem; }
      .steps a { display: inline-block; margin-top: 0.625rem; font-size: 0.875rem; color: var(--color-accent); text-decoration: none; }
      .steps a:hover { text-decoration: underline; }

      .limits { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 2.5rem; align-items: start; padding: 2.25rem; border: 1px solid var(--color-border); border-radius: 1.25rem; background: var(--color-raised); }
      .limits h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; line-height: 1.2; }
      .limits > div > p { color: var(--color-muted-foreground); margin: 0.75rem 0 1.25rem; }
      .limits ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
      .limits li { padding: 0.875rem 1rem; border: 1px solid var(--color-border); border-radius: 0.75rem; background: var(--color-background); }
      .limits li b { display: block; font-size: 0.9375rem; }
      .limits li span { font-size: 0.875rem; color: var(--color-muted-foreground); }
      .limits li span a { color: var(--color-accent); }

      .faq { max-width: 51rem; margin: 0 auto; display: grid; gap: 0.625rem; }
      .faq details { border: 1px solid var(--color-border); border-radius: 0.75rem; background: var(--color-background); }
      .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 44px; padding: 1.125rem 1.25rem; font-weight: 600; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: "+"; font-size: 1.375rem; line-height: 1; color: var(--color-accent); }
      .faq details[open] summary::after { content: "−"; }
      .faq details p { padding: 0 1.25rem 1.125rem; color: var(--color-muted-foreground); font-size: 0.9375rem; }

      .cta { text-align: center; padding-top: 4.5rem; padding-bottom: 4.5rem; }
      .cta h2 { font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; }
      .cta p { color: var(--color-muted-foreground); margin: 0.75rem auto 1.625rem; max-width: 34em; }

      .site-footer { border-top: 1px solid var(--color-border); }
      .footer-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; padding-top: 2.25rem; padding-bottom: 2.25rem; font-size: 0.875rem; color: var(--color-muted-foreground); }
      .footer-row nav { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-left: auto; }
      .footer-row a { text-decoration: none; }
      .footer-row a:hover { color: var(--color-foreground); }

      @media (max-width: 65rem) {
        .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (max-width: 56rem) {
        .hero-grid { grid-template-columns: 1fr; padding-top: 3rem; padding-bottom: 3.5rem; }
        .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .limits { grid-template-columns: 1fr; padding: 1.5rem; }
        .cli-grid { grid-template-columns: 1fr; gap: 2rem; }
      }
      @media (max-width: 47.5rem) {
        .site-header nav a:not(.button):not(.lang-switch) { display: none; }
        .site-header nav { gap: 0.875rem; }
        .steps { grid-template-columns: 1fr; }
      }
      @media (max-width: 35rem) {
        .plans, .features { grid-template-columns: 1fr; }
        .block { padding-top: 3.5rem; padding-bottom: 3.5rem; }
        .block-tight { padding-top: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .button { transition: none; }
        .button-primary:hover { transform: none; }
      }
    </style>
  </body>
</html>
